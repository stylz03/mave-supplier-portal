/* ============================================================
   VANTA MOTORWORKS — Private Automotive Atelier
   Exact static rebuild of reference/reference.png per STUDY.md
   Plain CSS. No JS. No external resources. Relative units only.
   ============================================================ */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  width: 100%;
}

html {
  height: 100%;
}

body {
  min-height: 100%;
}

/* Scroll runway: gives the fixed stage its scrub range */
.scroll-space {
  height: 760vh;
  pointer-events: none;
}

/* no-film fallback (reduced motion / missing frames): stay static */
.no-film .scroll-space {
  display: none;
}

body {
  overflow-x: hidden;
  background: #1b140e;
  font-family: "Avenir Next", "Century Gothic", "Futura", "Trebuchet MS", sans-serif;
  font-weight: 400;
  color: #f2ede6;
  -webkit-font-smoothing: antialiased;
}

.stage {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #1b140e;
}

a {
  text-decoration: none;
  color: inherit;
}

/* ------------------------------------------------------------
   Layer 1 — background plate (STUDY §4, §7)
   ------------------------------------------------------------ */
.bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

/* ------------------------------------------------------------
   Layer 2 — giant outline word (STUDY §6b)
   spans x 13% → 87% W, cap top y≈21.8% H, cap height ≈ 15.9% H
   ------------------------------------------------------------ */
.display-word {
  position: absolute;
  z-index: 2;
  /* left compensates the P's left sidebearing so INK starts at 13% W */
  left: 12.1%;
  top: 20.2vh;
  font-family: "Century Gothic", "Futura", "Avenir Next", sans-serif;
  font-size: 10.6vw;
  line-height: 1;
  font-weight: 400;
  letter-spacing: 0.23em;
  white-space: nowrap;
  color: transparent;
  -webkit-text-stroke: 0.1vw rgba(245, 240, 230, 0.92);
}

/* Front copy of the display word: sits ABOVE the film canvas so the
   headline stays on screen through the whole scroll. Starts hidden and
   is faded in by js/scroll-film.js as the film takes over, which keeps
   the at-rest hero identical to the reference (car overlapping the type). */
.display-word--front {
  z-index: 4;
  opacity: 0;
  will-change: opacity;
}

/* ------------------------------------------------------------
   Layer 3 — hero car + reflection (STUDY §5)
   x 19.7% → 87.9% W, wheels-bottom at 76.5% H
   ------------------------------------------------------------ */
.car-layer {
  position: absolute;
  z-index: 3;
  left: 23.2%;
  width: 64.5%;
  bottom: 23.5%;
}

.car {
  display: block;
  width: 100%;
  height: auto;
}

.car-reflection {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  height: auto;
  transform: scaleY(-1);
  opacity: 0.22;
  /* element is flipped, so local bottom = visual top of the reflection:
     keep only the top ~30% of the flipped copy visible */
  -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 30%);
  mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 30%);
}

/* ------------------------------------------------------------
   Layer 3b — scroll film canvas: above word + car, below UI.
   Opacity is driven by js/scroll-film.js; the word and the
   static car layer hand off to it on first scroll.
   ------------------------------------------------------------ */
.film {
  position: absolute;
  inset: 0;
  z-index: 3;
  opacity: 0;
  pointer-events: none;
}

.display-word,
.car-layer {
  will-change: opacity;
}

/* ------------------------------------------------------------
   Layer 4 — UI. Header (STUDY §6a), row center-line y ≈ 8.1% H
   ------------------------------------------------------------ */
.logo {
  position: absolute;
  z-index: 4;
  left: 3.3%;
  top: 4.2%;
  width: 4.8%;
  height: 8%;
}

.logo svg {
  display: block;
  width: 100%;
  height: 100%;
}

.brand {
  position: absolute;
  z-index: 4;
  left: 8.9%;
  top: 8.1%;
  transform: translateY(-50%);
  white-space: nowrap;
}

.brand-name {
  font-size: 0.78vw;
  font-weight: 500;
  letter-spacing: 0.25em;
  color: #f7f2ea;
}

.brand-sub {
  margin-top: 0.75vh;
  font-size: 0.57vw;
  letter-spacing: 0.22em;
  color: #cabda9;
}

.nav-link {
  position: absolute;
  z-index: 4;
  top: 8.1%;
  transform: translate(-50%, -50%);
  font-size: 0.72vw;
  font-weight: 500;
  letter-spacing: 0.2em;
  color: #efe9df;
  white-space: nowrap;
}

.nav-services    { left: 36.2%; }
.nav-performance { left: 45.9%; }
.nav-atelier     { left: 55.3%; }
.nav-journal     { left: 63.5%; }

/* Dark glassy pill — x 84.3–96.5% W, y 5.6–10.6% H */
.cta {
  position: absolute;
  z-index: 4;
  left: 84.3%;
  top: 5.6%;
  width: 12.2%;
  height: 5%;
  border-radius: 100vh;
  border: 1px solid rgba(240, 233, 220, 0.7);
  background: rgba(18, 13, 9, 0.35);
  -webkit-backdrop-filter: blur(0.3vw);
  backdrop-filter: blur(0.3vw);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.72vw;
  font-weight: 500;
  letter-spacing: 0.18em;
  color: #f7f2ea;
  white-space: nowrap;
}

.cta-arrow {
  letter-spacing: 0;
}

/* ------------------------------------------------------------
   Left text block (STUDY §6c)
   ------------------------------------------------------------ */
.left-rule {
  position: absolute;
  z-index: 4;
  left: 4.1%;
  top: 41.8%;
  height: 8.4%;
  width: 1px;
  background: linear-gradient(
    to bottom,
    #cf8f45 0%,
    #cf8f45 21.4%,
    rgba(120, 110, 95, 0.7) 21.4%,
    rgba(120, 110, 95, 0.7) 100%
  );
}

.kicker {
  position: absolute;
  z-index: 4;
  left: 5%;
  top: 42.4%;
  transform: translateY(-50%);
  font-size: 0.58vw;
  font-weight: 500;
  letter-spacing: 0.22em;
  color: #e6dac6;
  white-space: nowrap;
}

.headline {
  position: absolute;
  z-index: 4;
  left: 5%;
  top: 46.2%;
  transform: translateY(-50%);
  font-size: 1.14vw;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: #f8f3eb;
  white-space: nowrap;
}

.tagline {
  position: absolute;
  z-index: 4;
  left: 5%;
  top: 50%;
  transform: translateY(-50%);
  font-size: 0.75vw;
  font-weight: 400;
  color: #d5cabb;
  white-space: nowrap;
}

/* ------------------------------------------------------------
   Right vertical rail (STUDY §6d)
   ------------------------------------------------------------ */
.rail-vertical {
  position: absolute;
  z-index: 4;
  left: 96.8%;
  top: 49.75%;
  transform: translate(-50%, -50%) rotate(-90deg);
  font-size: 0.6vw;
  font-weight: 500;
  letter-spacing: 0.28em;
  color: #e2dacd;
  white-space: nowrap;
}

.rail-count {
  position: absolute;
  z-index: 4;
  left: 96.5%;
  top: 66%;
  transform: translate(-50%, -50%);
  font-size: 0.66vw;
  letter-spacing: 0.15em;
  color: #f2ede6;
  white-space: nowrap;
}

.rail-total {
  color: rgba(214, 206, 194, 0.55);
}

/* ------------------------------------------------------------
   INSPECT hotspot (STUDY §6e)
   circle center (64.5% W, 69.9% H), Ø ≈ 2.75% W
   ------------------------------------------------------------ */
.hotspot {
  position: absolute;
  z-index: 4;
  left: 64.5%;
  top: 69.9%;
  width: 2.75vw;
  height: 2.75vw;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 0.08vw solid rgba(214, 152, 74, 0.95);
  background: rgba(18, 13, 9, 0.25);
}

/* tiny white ring-dot at center */
.hotspot::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0.3vw;
  height: 0.3vw;
  transform: translate(-50%, -50%);
  border: 0.12vw solid #ffffff;
  border-radius: 50%;
}

/* short thin gold tick extending right from ring edge */
.hotspot::after {
  content: "";
  position: absolute;
  left: 100%;
  top: 50%;
  width: 0.9vw;
  height: 1px;
  background: rgba(207, 143, 69, 0.9);
}

.hotspot-label {
  position: absolute;
  z-index: 4;
  left: 66.2%;
  top: 72.4%;
  transform: translateY(-50%);
  font-size: 0.54vw;
  font-weight: 500;
  letter-spacing: 0.25em;
  color: #f5f0e7;
  white-space: nowrap;
}

/* ------------------------------------------------------------
   Bottom glassy service bar (STUDY §6f)
   x 16.1–83.1% W, y 80.6–88.2% H
   ------------------------------------------------------------ */
.service-bar {
  position: absolute;
  z-index: 4;
  left: 16.1%;
  top: 80.6%;
  width: 67%;
  height: 7.6%;
  border-radius: 0.84vw;
  border: 1px solid rgba(240, 233, 220, 0.28);
  background: linear-gradient(to right, rgba(26, 18, 11, 0.35), rgba(58, 44, 30, 0.5));
  -webkit-backdrop-filter: blur(0.4vw);
  backdrop-filter: blur(0.4vw);
}

.service {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 0.7vw;
  white-space: nowrap;
}

/* 6 sections spacing */
.service-1 { left: 2%; }
.service-2 { left: 18.6%; }
.service-3 { left: 35.3%; }
.service-4 { left: 52%; }
.service-5 { left: 68.6%; }

.num {
  font-size: 1.56vw;
  font-weight: 200;
  letter-spacing: 0.04em;
  color: #cfc8bd;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 0.55vh;
}

.s-title {
  font-size: 0.65vw;
  font-weight: 500;
  letter-spacing: 0.15em;
  color: #f7f2ea;
}

.s-sub {
  font-size: 0.55vw;
  font-weight: 400;
  letter-spacing: 0.12em;
  color: #c6bcb0;
}

.s-sub.gold {
  color: #d99e58;
}

.sep {
  position: absolute;
  top: 18%;
  bottom: 18%;
  width: 1px;
  background: rgba(255, 255, 255, 0.18);
}

/* page-x -> bar-relative spacing */
.sep-1 { left: 16.6%; }
.sep-2 { left: 33.3%; }
.sep-3 { left: 50%; }
.sep-4 { left: 66.6%; }
.sep-5 { left: 83.3%; }

.total-suppliers {
  position: absolute;
  left: 86%;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 0.8vw;
}

.tot-title {
  font-size: 0.8vw;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: #f7f2ea;
}

.tot-num {
  font-size: 2.2vw;
  font-weight: 700;
  color: #cf8f45;
}

/* ------------------------------------------------------------
   Footer line + progress (STUDY §6g)
   ------------------------------------------------------------ */
.explore {
  position: absolute;
  z-index: 4;
  left: 49%;
  top: 93.7%;
  transform: translate(-50%, -50%);
  font-size: 0.66vw;
  font-weight: 500;
  letter-spacing: 0.35em;
  color: #e8e1d6;
  white-space: nowrap;
}

.progress {
  position: absolute;
  z-index: 4;
  left: 3.6%;
  top: 96.2%;
  width: 15.9%;
  height: 0;
}

.progress .track {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1px;
  transform: translateY(-50%);
  background: rgba(235, 228, 215, 0.5);
}

/* brighter white portion x 3.6→13% of page = 0→59.1% of track */
.progress .done {
  position: absolute;
  left: 0;
  width: 59.1%;
  top: 0;
  height: 1px;
  transform: translateY(-50%);
  background: #ffffff;
}

/* gold segment x 13→16% of page = 59.1→78% of track */
.progress .gold-seg {
  position: absolute;
  left: 59.1%;
  width: 18.9%;
  top: 0;
  height: 0.3vh;
  transform: translateY(-50%);
  background: #cf8f45;
}

/* ------------------------------------------------------------
   Global hairline frame (STUDY §2)
   ------------------------------------------------------------ */
.frame {
  position: absolute;
  z-index: 5;
  left: 1.7%;
  right: 1.7%;
  top: 3.2%;
  bottom: 3.2%;
  border: 1px solid rgba(235, 228, 215, 0.55);
  border-radius: 1.4vw;
  pointer-events: none;
}

/* Mobile responsiveness */
@media (max-width: 900px) {
  /* Center the car */
  .car-layer {
    left: 2%;
    width: 96%;
    bottom: 30%;
  }

  .display-word {
    font-size: 16vw;
    top: 25%;
    -webkit-text-stroke: 1px rgba(245, 240, 230, 0.85);
  }

  /* Header adjustments */
  .logo { left: 5% !important; top: 4% !important; width: auto !important; }
  .logo span { font-size: 8vw !important; }

  .brand { left: 5% !important; top: 10% !important; transform: none; }
  .brand-name { font-size: 5vw; }
  .brand-sub { font-size: 2.5vw; margin-top: 1vh; }

  /* Navigation */
  .nav-link { font-size: 2.5vw; top: 16%; }
  .nav-services    { left: 15%; }
  .nav-performance { left: 35%; }
  .nav-atelier     { left: 60%; }
  .nav-journal     { left: 85%; }

  .cta {
    left: auto; right: 5%; top: 4%; width: 35%; height: 5vh; font-size: 3vw; transform: none;
  }

  /* Left text block */
  .left-block { top: 22%; left: 5%; }
  .kicker { font-size: 3vw; }
  .headline { font-size: 7vw; }
  .tagline { font-size: 3.5vw; }

  .rail { display: none; }

  /* Service bar - make it a grid */
  .service-bar {
    width: 94%;
    left: 3%;
    height: auto;
    bottom: 3%;
    top: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 4vw;
    border-radius: 4vw;
    background: rgba(18, 13, 9, 0.85);
  }

  .service {
    position: relative !important;
    left: auto !important;
    top: auto !important;
    transform: none !important;
    width: 30%;
    margin-bottom: 2vh;
    gap: 2vw;
  }

  .total-suppliers {
    position: relative !important;
    left: auto !important;
    top: auto !important;
    transform: none !important;
    width: 30%;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    margin-bottom: 2vh;
  }

  .num { font-size: 7vw; }
  .s-title { font-size: 3vw; }
  .s-sub { font-size: 2.5vw; }
  .tot-title { font-size: 4vw; }
  .tot-num { font-size: 9vw; }

  .sep { display: none; }
  
  .hotspot { left: 80%; top: 60%; width: 8vw; height: 8vw; }
  .hotspot-label { left: 85%; top: 65%; font-size: 3vw; }
  
  .explore, .progress { display: none; }
}
